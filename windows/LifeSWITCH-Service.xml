<service>
  <id>LifeSWITCHBooth</id>
  <name>LifeSWITCH Booth</name>
  <description>LifeSWITCH local ATEM control service</description>
  <executable>%BASE%\runtime\node.exe</executable>
  <arguments>"%BASE%\booth\server.js" "%BASE%\config.json"</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <serviceaccount>
    <username>NT AUTHORITY\LocalService</username>
  </serviceaccount>
  <startmode>Automatic</startmode>
  <stoptimeout>15sec</stoptimeout>
  <logpath>%ProgramData%\LifeSWITCH\Logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>1024</sizeThreshold>
    <keepFiles>4</keepFiles>
  </log>
</service>
